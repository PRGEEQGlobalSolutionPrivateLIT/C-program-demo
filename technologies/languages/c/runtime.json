{
  "runtimeId": "c-gcc",
  "technology": "c",
  "image": "elabs-c-runtime:latest",
  "compiler": "gcc",
  "compileCommand": [
    "gcc",
    "-std=c17",
    "-Wall",
    "-Wextra",
    "-O2",
    "main.c",
    "-o",
    "main"
  ],
  "executeCommand": [
    "./main"
  ],
  "defaultFile": "main.c",
  "timeoutSeconds": 5,
  "compileTimeoutSeconds": 10,
  "memoryMB": 256,
  "cpu": 0.5,
  "pidsLimit": 64,
  "networkEnabled": false
}